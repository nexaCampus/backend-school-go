# Render Server Port (Auto-injected by Render)
PORT=8080

# Supabase Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Direct PostgreSQL Connection String for pgxpool (Transaction Mode: Port 6543)
# Replace [YOUR_DATABASE_PASSWORD] with your actual Supabase DB password
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR_DATABASE_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# App Security (Use a cryptographically secure 64+ char random hex string in production)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# CORS Whitelist (comma-separated, e.g. https://portal.nexacampus.edu,http://localhost:3000)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
